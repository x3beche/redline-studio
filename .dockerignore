# The images built with the checkout as context (docker/kicad.Dockerfile,
# docker/tracemaker.Dockerfile) copy at most a file or two from it: keep the
# environments, caches and secrets out of what is sent to the builder.
.git
.env
.secrets
.venv
.venv-ato
venv
.cache
**/__pycache__
.pytest_cache
frontend/node_modules
frontend/dist
frontend/.angular
# The deployment's images (docker/deploy) copy the checkout: nothing local
# goes with it - an agent's settings, the outputs start.sh makes again.
.claude/settings.local.json
assets
exports
views
revisions
*.env
