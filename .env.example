# The connection string is read here only; it never reaches the frontend.
# Copy this file to .env — that name is git-ignored.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=redline

# Storage quota shown in the UI gauge. Atlas M0 (free tier) gives 512 MB.
STORAGE_QUOTA_MB=512

# Model keys (OpenRouter, Command Code) do not go here: they are kept in the
# database and typed in the app - Settings > LLM settings - which is also where each
# job (card summaries, translation, tool pages, tool finder, the Command Code room)
# picks its provider and model. The server never reads them from the environment.

# Signing in (docs/USERS-PLAN.md). Off is local mode: nobody signs in and
# every request is the local user - the app as it runs on this machine.
# On: every API request needs a session; the first visit makes the owner's
# account. With it on, each agent needs a token: make one under your name in
# the app (user menu > Agent tokens) and give it to the agent, not this file.
REDLINE_REQUIRE_SIGNIN=false
# Who can open the page (./start.sh): 127.0.0.1 is this machine only;
# 0.0.0.0 is the office network too - turn sign-in on first, and make the
# owner's account before opening it. The API itself stays on this machine.
# REDLINE_WEB_HOST=0.0.0.0
# The local user's name, shown on notes and in the audit trail.
REDLINE_LOCAL_USER=you
# Set by each agent for itself (not here): its name on runs, log lines,
# thread replies and changes, e.g. REDLINE_AGENT="pcb room".
# Also the agent's own, never here: REDLINE_TRANSPORT=api to reach the database
# through the server instead of MONGODB_URI, REDLINE_API=http://localhost:8000,
# and REDLINE_TOKEN=<the rlat_... token the app showed once>.

# How much of the machine one build container may take (backend/limits.py).
# Unset: half the cores, 40 % of the memory up to 12g, 4096 processes.
# REDLINE_BOX_CPUS=8
# REDLINE_BOX_MEMORY=12g
# REDLINE_BOX_PIDS=4096
