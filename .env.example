# The connection string is read here only; it never reaches the frontend.
# Copy this file to .env — that name is git-ignored.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=redline

# Database quota the Analytics room forecasts against. Atlas M0 (free tier) gives 512 MB.
STORAGE_QUOTA_MB=512

# Model keys (OpenRouter, Command Code) do not go here: they are kept in the
# database and typed in the app - Settings > LLM settings - which is also where each
# job (card summaries, translation, tool pages, tool finder, the Command Code room)
# picks its provider and model. The server never reads them from the environment.

# Signing in (docs/USERS-PLAN.md). Off is local mode: nobody signs in and
# every request is the local user - the app as it runs on this machine.
# On: every API request needs a session; the first visit makes the owner's
# account. With it on, each agent needs a token: make one under your name in
# the app (user menu > Agent tokens) and give it to the agent, not this file.
REDLINE_REQUIRE_SIGNIN=false
# Who can open the page (./start.sh): 127.0.0.1 is this machine only;
# 0.0.0.0 is the office network too - turn sign-in on first, and make the
# owner's account before opening it. The API itself stays on this machine.
# REDLINE_WEB_HOST=0.0.0.0
# The local user's name, shown on notes and in the audit trail.
REDLINE_LOCAL_USER=you
# The key the secrets typed in Settings (model API keys, Jina's key, the proxy
# and McMaster passwords, the Telegram token) are encrypted with in the
# database: a Fernet key or any long passphrase. Unset, one is made once in
# .secrets/secret.key (git-ignored). Lose it and those secrets are typed again.
# REDLINE_SECRET_KEY=
# Set by each agent for itself (not here): its name on runs, log lines,
# thread replies and changes, e.g. REDLINE_AGENT="pcb room".
# Also the agent's own, never here: REDLINE_TRANSPORT=api to reach the database
# through the server instead of MONGODB_URI, REDLINE_API=http://localhost:8000,
# and REDLINE_TOKEN=<the rlat_... token the app showed once>.

# How much of the machine one build container may take (backend/limits.py).
# Unset: half the cores, 40 % of the memory up to 12g, 4096 processes.
# REDLINE_BOX_CPUS=8
# REDLINE_BOX_MEMORY=12g
# REDLINE_BOX_PIDS=4096

# --- Everything below is optional; the values shown are the defaults. ---
# (INSTALL.md > Configuration says more about each.)

# Builds and the build cache (backend/buildcache.py, links.py, store.py).
# REDLINE_BUILD_MEM=10G               memory one build may use before it is killed
# REDLINE_BUILD_CACHE=.cache/build
# REDLINE_BUILD_CACHE_MAX=4G
# REDLINE_BUILD_CACHE_DEBUG=0
# REDLINE_BUILD_WARM=                 off: no warm build process kept ready
# REDLINE_BUILD_TEARDOWN=off
# REDLINE_FASTGEOM=                   off: build123d's own geometry; check: both, compared
# REDLINE_LINK_BUILDS=                rebuilds of linked models at once (unset: what the machine has room for)
# REDLINE_LINK_DEBOUNCE=4
# REDLINE_CACHE=.cache/artifacts
# REDLINE_FILE_MAX_MB=200             largest file an upload may be
# REDLINE_STEP_MESH_TIMEOUT=600

# The images work is run in, through the Docker socket (see INSTALL.md).
# REDLINE_DRAW_IMAGE=redline-draw
# REDLINE_KICAD_IMAGE=redline-kicad
# REDLINE_TRACEMAKER_IMAGE=redline-tracemaker
# REDLINE_FIRMWARE_IMAGE=redline-firmware
# REDLINE_TOOLS_IMAGE=redline-tools
# REDLINE_KIT_IMAGE=node:20-alpine
# REDLINE_CHROME_IMAGE=zenika/alpine-chrome:with-puppeteer
# REDLINE_PDF_IMAGE=zenika/alpine-chrome:with-puppeteer
# REDLINE_CHROME=                     a Chrome / Chromium binary on this machine, instead of looking for one
# REDLINE_DRAW_AT_ONCE=3
# REDLINE_DRAW_AFTER_S=600
# REDLINE_FIRMWARE_TIMEOUT=900
# REDLINE_PDF_TIMEOUT=90

# The board room's tools (backend/atoenv.py): unset, .venv-ato in the checkout.
# REDLINE_ATO=.venv-ato/bin/ato
# REDLINE_EASYEDA=.venv-ato/bin/easyeda2kicad
# REDLINE_ATO_PYTHON=.venv-ato/bin/python
# REDLINE_LCSC_GAP=2.5                seconds between two asks to LCSC / EasyEDA
# REDLINE_LCSC_BUDGET=25
# REDLINE_LCSC_CACHE=.cache/lcsc

# Figures and time.
# REDLINE_TZ=Europe/Istanbul
# REDLINE_WATTS_PER_CORE=8.0
# REDLINE_WATTS_GPU=                  unset: the card's rated limit
# REDLINE_KWH_PRICE=                  USD per kWh; unset shows energy without money
# REDLINE_RAPL_PROMETHEUS=            a Prometheus scraping node_exporter's RAPL, e.g. http://127.0.0.1:9090
# REDLINE_TRANSCRIPTS=                agent transcript folders for the token analytics
# REDLINE_TRANSCRIPTS_CWD=            unset: this checkout
# REDLINE_TOOLS_MODELS=               extra OpenRouter models for the tool finder, comma separated
# REDLINE_AGENT_SEED=https://github.com/x3beche/redline-agent-seed
# REDLINE_LEASE_MINUTES=45            an agent session not heard from this long loses its run
# REDLINE_SECRET_KEY_FILE=.secrets/secret.key

# The agents' own, set in their environment and not here: REDLINE_AGENT,
# REDLINE_TRANSPORT, REDLINE_API, REDLINE_TOKEN, REDLINE_WORKSPACE,
# REDLINE_ROOM, REDLINE_SEAT, REDLINE_BUILD / REDLINE_PARTS (=local),
# REDLINE_WEB and REDLINE_RENDER_CALL_TIMEOUT (tools/render.py).
# Set by the server for its own child processes, never by hand:
# REDLINE_BUILD_JOB, REDLINE_CC_GEN, REDLINE_IMPORT_ONLY, REDLINE_REVISION,
# REDLINE_PAGE_SESSION.
