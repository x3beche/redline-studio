# The connection string is read here only; it never reaches the frontend.
# Copy this file to .env — that name is git-ignored.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=assets_3d

# Storage quota shown in the UI gauge. Atlas M0 (free tier) gives 512 MB.
STORAGE_QUOTA_MB=512

# OpenRouter key for card summaries (server side only, never sent to the browser)
OPENROUTER_API_KEY=sk-or-v1-...
