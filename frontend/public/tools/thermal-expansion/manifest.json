          "pa66",
          "Nylon PA66"
        ],
        [
          "pa66gf",
          "PA66-GF30 (flow dir.)"
        ],
        [
          "pom",
          "Acetal POM"
        ],
        [
          "pmma",
          "Acrylic PMMA"
        ],
        [
          "pla",
          "PLA"
        ],
        [
          "petg",
          "PETG"
        ],
        [
          "peek",
          "PEEK"
        ],
        [
          "ptfe",
          "PTFE"
        ],
        [
          "hdpe",
          "HDPE"
        ],
        [
          "custom",
          "Custom"
        ]
      ]
