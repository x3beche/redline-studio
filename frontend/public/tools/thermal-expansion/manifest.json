    },
    {
      "key": "gap",
      "label": "Clearance to the housing at T1",
      "type": "number",
      "unit": "mm",
      "default": "0.2",
      "required": false,
      "when": {
        "key": "mate",
        "in": [
          "al",
          "steel",
          "ss",
          "brass",
          "cu",
          "ti",
          "zamak",
          "invar",
          "fr4",
          "fr4z",
          "alumina",
          "si",
          "glass",
          "abs",
          "pc",
          "pa66",
          "pa66gf",
          "pom",
          "pmma",
          "pla",
          "petg",
          "peek",
          "ptfe",
          "hdpe"
        ]
      },
      "help": "Total gap along the length between the part and the mating part. The part is the one inside."
    }
  ],
  "examples": [
    {
      "title": "100 mm aluminium heatsink bolted to an FR-4 board, 20 to 85 °C",
      "input": {
        "length": "100",
        "material": "al",
        "t1": "20",
        "t2": "85",
        "mate": "fr4",
        "gap": "0.2"
      }
    },
    {
      "title": "PCB in an ABS enclosure slot, cold start at −40 °C",
      "input": {
        "length": "150",
        "material": "fr4",
        "t1": "23",
        "t2": "-40",
        "mate": "abs",
        "gap": "0.3"
      }
    }
  ],
  "usage": "Give the length in mm, the part material (key such as al, steel, fr4, abs, or custom with cte in ppm/K), T1 and T2 in °C, and optionally a mating material and the clearance in mm. It returns ΔL in µm, the length at T2, strain, area and volume change, the fully restrained stress in MPa, the relative movement against the mating part and the clearance at T2 (negative = interference). Use it for fits across temperature, slot sizes, or CTE mismatch between a board and a housing or heatsink.",
  "sources": [
    "ΔL = α·L·ΔT and σ = E·α·ΔT: any mechanics of materials text (e.g. Gere & Goodno, Mechanics of Materials, ch. 2)",
    "CTE, modulus and yield: MatWeb and ASM Handbook typical values; FR-4 from Isola 370HR datasheet"
  ]
}