{
  "id": "thermal-expansion", "version": "1.1",
  "name": "Thermal Expansion Calculator",
  "blurb": "dimension change of a part over a temperature change",
  "group": "mechanical",
  "layout": "custom",
  "agentOmit": ["draw"],
  "rooms": [
    "cad",
    "pcb"
  ],
  "keywords": [
    "thermal expansion",
    "cte",
    "coefficient of thermal expansion",
    "alpha",
    "ppm/k",
    "growth",
    "temperature change",
    "mismatch",
    "clearance",
    "interference",
    "thermal stress",
    "delta l",
    "fr-4",
    "aluminium"
  ],
  "intro": "How much a length or diameter grows or shrinks between two temperatures (ΔL = α·L·ΔT), and, with a mating material, how much the two move against each other and whether a clearance closes. Typical room-temperature CTEs are used; the stress if the part were fully restrained is shown too.",
  "inputs": [
    {
      "key": "length",
      "label": "Length or diameter at T1",
      "type": "number",
      "unit": "mm",
      "default": "100"
    },
    {
      "key": "material",
      "label": "Part material",
      "type": "select",
      "default": "al",
      "options": [
        [
          "al",
          "Aluminium 6061"
        ],
        [
          "steel",
          "Steel (carbon)"
        ],
        [
