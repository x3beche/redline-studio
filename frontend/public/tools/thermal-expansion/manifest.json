    {
      "key": "cte",
      "label": "CTE",
      "type": "number",
      "unit": "ppm/K",
      "default": "23",
      "when": {
        "key": "material",
        "equals": "custom"
      }
    },
    {
      "key": "emod",
      "label": "Young's modulus (optional)",
      "type": "number",
      "unit": "GPa",
      "default": "",
      "required": false,
      "when": {
        "key": "material",
        "equals": "custom"
      }
    },
    {
      "key": "t1",
      "label": "T1 (assembly / reference)",
      "type": "number",
      "unit": "°C",
      "default": "20"
    },
    {
      "key": "t2",
      "label": "T2 (operating)",
      "type": "number",
      "unit": "°C",
      "default": "85"
    },
    {
      "key": "mate",
      "label": "Mating part / housing",
      "type": "select",
      "default": "fr4",
      "options": [
