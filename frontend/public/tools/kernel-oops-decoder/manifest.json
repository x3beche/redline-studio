{
 "id": "kernel-oops-decoder",
 "version": "1.0",
 "name": "Kernel Oops Decoder",
 "blurb": "a Linux oops or panic taken apart: the cause, the faulting function, the call trace and the taint flags",
 "group": "pcb",
 "layout": "custom",
 "view": true,
 "rooms": ["pcb"],
 "keywords": [
  "kernel oops",
  "kernel panic",
  "NULL pointer dereference",
  "Unable to handle kernel paging request",
  "call trace",
  "ESR",
  "ESR_EL1",
  "data abort",
  "tainted",
  "taint flags",
  "faddr2line",
  "decode_stacktrace",
  "BUG:",
  "WARNING",
  "soft lockup",
  "hung task",
  "general protection fault",
  "dmesg crash",
  "arm64 fault"
 ],
 "intro": "Reads an oops, BUG, WARNING, lockup or panic as the kernel prints it (ARM, ARM64, x86_64, RISC-V) and says what failed and where: the kind and fault address, the faulting function, the call stack, the registers that hold NULL or the fault address, the arm64 ESR / x86 page fault code / ARM FSR / RISC-V cause decoded bit by bit, the faulting instruction from the Code: line (arm64, ARM) and the taint letters per tainted-kernels.rst.",
 "inputs": [
  {
   "key": "oops",
   "label": "Oops text",
   "type": "textarea",
   "rows": 14,
