  {
   "key": "arch",
   "label": "Architecture",
   "type": "select",
   "default": "auto",
   "options": [
    [
     "auto",
     "Auto-detect"
    ],
    [
     "arm64",
     "ARM64 (AArch64)"
    ],
    [
     "arm",
     "ARM (32-bit)"
    ],
    [
     "x86_64",
     "x86_64"
    ],
    [
     "riscv",
     "RISC-V"
    ]
   ]
  },
  {
   "key": "code",
   "label": "Fault code override (hex)",
   "type": "text",
   "default": "",
   "placeholder": "0x96000045",
   "help": "Decode this ESR / #PF code / FSR / scause instead of the log's value (to see what a bit means)."
  },
  {
   "key": "vmlinux",
   "label": "vmlinux path",
   "type": "text",
   "default": "vmlinux",
   "help": "Used in the commands."
  },
  {
   "key": "moddir",
   "label": "Modules directory",
   "type": "text",
   "default": "",
   "placeholder": "path/to/modules",
   "help": "Where the .ko files with debug info are; used in the commands."
  },
  {
   "key": "cross",
   "label": "Cross prefix",
   "type": "text",
   "default": "auto",
   "help": "CROSS_COMPILE for the commands: auto from the architecture, none, or e.g. aarch64-poky-linux-."
  }
 ],
