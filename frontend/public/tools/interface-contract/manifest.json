    {
      "title": "Two sensors on the same address",
      "input": {
        "board": "weather",
        "mcu_rail": "3.3",
        "rails": [
          {
            "name": "3V3",
            "volts": "3.3"
          }
        ],
        "gpio": [
          {
            "signal": "SDA",
            "pin": "PB7",
            "dir": "od",
            "pull": "up"
          },
          {
            "signal": "SCL",
            "pin": "PB6",
            "dir": "od",
            "pull": "up"
          }
        ],
        "i2c": [
          {
            "bus": "1",
            "addr": "0x76",
            "device": "BME280 A",
            "khz": "400"
