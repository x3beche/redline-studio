            "notes": "2k2 on board"
          },
          {
            "signal": "I2C_SCL",
            "pin": "GPIO9",
            "dir": "od",
            "rail": "",
            "pull": "up",
            "notes": "2k2 on board"
          },
          {
            "signal": "LED_STATUS",
            "pin": "GPIO2",
            "dir": "out",
            "rail": "",
            "pull": "none",
            "notes": "active high"
          },
          {
            "signal": "BTN_USER",
            "pin": "GPIO0",
