{
  "id": "fmea-lite", "version": "1.1",
  "name": "FMEA Lite",
  "blurb": "failure modes scored by likelihood and effect into a risk order",
  "group": "project",
  "rooms": [
    "analyze"
  ],
  "keywords": [
    "fmea",
    "dfmea",
    "pfmea",
    "failure mode",
    "rpn",
    "risk priority number",
    "severity",
    "occurrence",
    "detection",
    "criticality",
    "risk assessment",
    "pareto",
    "reliability",
    "iec 60812"
  ],
  "intro": "Score each failure mode 1-10 for severity, occurrence and detection. It ranks them by Risk Priority Number (S×O×D, AIAG / IEC 60812) or by criticality S×O, flags every mode over the action threshold and every high-severity mode whatever its score, and shows how few modes carry 80 % of the risk.",
  "inputs": [
    {
      "key": "modes",
      "label": "Failure modes",
      "type": "table",
      "help": "S: 1 no effect … 10 hazardous without warning. O: 1 very unlikely … 10 almost certain. D: 1 certain to be caught … 10 cannot be detected before the user sees it. S/O/D after: optional re-scores once the planned action is done (blank = unchanged).",
      "columns": [
        {
          "key": "item",
          "label": "Item / function",
          "default": ""
        },
        {
          "key": "mode",
          "label": "Failure mode",
          "default": ""
        },
        {
          "key": "effect",
          "label": "Effect",
          "default": ""
        },
        {
          "key": "cause",
          "label": "Cause",
          "default": ""
        },
        {
          "key": "s",
          "label": "S",
          "default": "5"
        },
        {
          "key": "o",
          "label": "O",
          "default": "5"
        },
        {
          "key": "d",
          "label": "D",
          "default": "5"
        },
        {
          "key": "action",
          "label": "Planned action",
          "default": ""
        },
        {
          "key": "rs",
          "label": "S after",
          "default": ""
        },
        {
          "key": "ro",
          "label": "O after",
          "default": ""
        },
        {
          "key": "rd",
          "label": "D after",
          "default": ""
        }
      ],
      "default": [
        {
          "item": "Li-ion charger",
          "mode": "Overcharge",
          "effect": "Cell swelling, fire",
          "cause": "Charger IC thermal foldback disabled",
          "s": "10",
          "o": "2",
          "d": "4",
          "action": "Add NTC cutoff, test at 45 °C",
          "rs": "10",
          "ro": "1",
          "rd": "2"
        },
        {
          "item": "USB-C port",
          "mode": "Connector cracks off board",
          "effect": "No charging",
          "cause": "Only SMD pads hold the shell",
          "s": "6",
          "o": "5",
          "d": "6",
          "action": "Through-hole shell tabs",
          "rs": "6",
          "ro": "2",
          "rd": "4"
        },
        {
          "item": "Firmware OTA",
          "mode": "Update bricks device",
          "effect": "Device dead in the field",
          "cause": "Power loss during flash write",
          "s": "8",
          "o": "3",
          "d": "5",
          "action": "A/B partitions with rollback",
          "rs": "8",
          "ro": "1",
          "rd": "3"
        },
        {
          "item": "Button",
          "mode": "Bounce double-press",
          "effect": "Menu skips an item",
          "cause": "No debounce",
          "s": "3",
          "o": "6",
          "d": "3",
          "action": ""
        },
        {
          "item": "BLE link",
          "mode": "Drops on phone sleep",
          "effect": "Data gap, user retries",
          "cause": "Supervision timeout too short",
          "s": "5",
          "o": "6",
          "d": "4",
          "action": ""
        },
        {
          "item": "Enclosure",
          "mode": "Water ingress at seam",
          "effect": "Corrosion, board failure",
          "cause": "Gasket compression set",
          "s": "8",
          "o": "3",
          "d": "7",
          "action": ""
        },
        {
          "item": "Temp sensor",
          "mode": "Reads 2 °C high",
          "effect": "Wrong display value",
          "cause": "Self-heating from nearby LDO",
          "s": "4",
          "o": "7",
          "d": "5",
          "action": ""
        }
      ]
    },
    {
      "key": "method",
      "label": "Score",
      "type": "select",
      "default": "rpn",
      "options": [
        [
          "rpn",
          "RPN = S × O × D"
        ],
        [
          "so",
          "Criticality = S × O (no detection)"
        ]
      ]
    },
    {
      "key": "rpnMin",
      "label": "Act at RPN ≥",
      "type": "number",
      "default": "100",
      "when": {
        "key": "method",
        "equals": "rpn"
      },
      "help": "100-125 is a common company threshold (of 1000)."
    },
    {
      "key": "soMin",
      "label": "Act at S×O ≥",
      "type": "number",
      "default": "30",
      "when": {
        "key": "method",
        "equals": "so"
      }
    },
    {
      "key": "sevMin",
      "label": "Always act at severity ≥",
      "type": "number",
      "default": "9",
      "help": "9-10 = safety or regulatory effects (AIAG)."
    }
  ],
