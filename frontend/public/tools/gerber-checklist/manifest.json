{
  "id": "gerber-checklist",
  "name": "Gerber Checklist",
  "blurb": "completeness of layers, drills, panel and notes before sending to fab",
  "group": "pcb",
  "rooms": [
    "pcb"
  ],
  "keywords": [
    "gerber",
    "gerbers",
    "fab files",
    "fabrication",
    "excellon",
    "drill file",
    "release checklist",
    "board outline",
    "ipc-356",
    "gbrjob",
    "pick and place",
    "bom",
    "stackup",
    "fab notes",
    "manufacturing package"
  ],
  "intro": "Tick what is in the zip; what is still open comes back with why the fab or assembler needs it. The items are the usual reasons an order is held or a board is built wrong, with Ucamco's Gerber X2 and IPC-D-356 as the file standards. Items marked (asm), (4+) only count when those boxes apply; the full wording of each open item is in the results.",
  "inputs": [
    {
      "key": "layers",
      "label": "Layer count",
      "type": "select",
      "default": "2",
      "options": [
        [
          "2",
          "2 layers"
        ],
        [
          "4",
          "4 layers"
        ],
        [
          "6",
          "6 or more"
        ]
      ]
    },
    {
      "key": "asm",
      "label": "Assembly too (SMT)",
      "type": "bool",
      "default": false
    },
    {
      "key": "panel",
      "label": "I supply the panel",
      "type": "bool",
      "default": false
    },
    {
      "key": "l_cu",
      "label": "Top/bottom copper",
      "type": "bool",
      "default": false
    },
    {
      "key": "l_inner",
      "label": "Inner layers (4+)",
      "type": "bool",
      "default": false
    },
    {
      "key": "l_mask",
      "label": "Solder mask",
      "type": "bool",
      "default": false
    },
    {
      "key": "l_silk",
      "label": "Silkscreen",
      "type": "bool",
      "default": false
    },
    {
      "key": "l_outline",
