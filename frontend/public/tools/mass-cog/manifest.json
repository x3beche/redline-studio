{
  "id": "mass-cog", "version": "1.0",
  "name": "Mass & CoG from Volume",
  "blurb": "mass and centre of gravity from volumes and materials",
  "group": "mechanical",
  "rooms": [
    "cad"
  ],
  "keywords": [
    "mass",
    "weight",
    "centre of gravity",
    "center of gravity",
    "cog",
    "cg",
    "centroid",
    "density",
    "volume",
    "moment of inertia",
    "balance",
    "assembly mass",
    "mass properties"
  ],
  "intro": "The total mass and centre of gravity of an assembly: each part's volume times its material density, placed at its centroid, then the mass-weighted average position. Negative volumes cut material out; a point-mass moment of inertia about the CoG comes along.",
  "inputs": [
    {
      "key": "unit",
      "label": "Volumes in",
      "type": "select",
      "default": "mm3",
      "options": [
        [
          "mm3",
          "mm³"
        ],
        [
          "cm3",
          "cm³ (ml)"
        ],
        [
          "in3",
          "in³"
        ],
        [
          "m3",
          "m³"
        ]
      ]
    },
    {
      "key": "infill",
      "label": "Infill of printed plastics (PLA, PETG, ABS, TPU)",
      "type": "number",
      "unit": "%",
      "default": "100",
      "help": "100 for moulded or solid parts. Only rows with one of these materials and no density of their own are scaled."
    },
    {
      "key": "parts",
      "label": "Parts (centroid x, y, z in mm; density overrides the material)",
      "type": "table",
      "columns": [
        {
          "key": "name",
          "label": "Part"
        },
        {
          "key": "material",
          "label": "Material",
          "type": "select",
          "options": [
            "Aluminium (6061/6082)",
            "Aluminium die cast (A380)",
            "Steel (carbon)",
            "Stainless steel (304/316)",
            "Brass",
            "Copper",
            "Titanium (Ti-6Al-4V)",
            "Magnesium (AZ31)",
            "Zinc die cast (Zamak)",
            "ABS",
            "PC",
            "PA66 nylon",
            "PA66-GF30",
            "POM (acetal)",
            "PMMA (acrylic)",
            "PLA",
            "PETG",
            "TPU",
            "Silicone rubber",
            "FR-4 (bare board)",
            "Populated PCB (average)",
            "Li-ion cell (cylindrical)",
            "Glass",
            "Wood (pine)",
            "Water"
          ],
          "default": "Aluminium (6061/6082)"
        },
        {
          "key": "volume",
          "label": "Volume"
        },
        {
          "key": "qty",
          "label": "Qty",
          "default": "1"
        },
        {
          "key": "x",
          "label": "x mm"
        },
        {
          "key": "y",
          "label": "y mm"
        },
        {
          "key": "z",
          "label": "z mm"
        },
        {
          "key": "density",
          "label": "ρ g/cm³ (opt.)"
        }
      ],
      "default": [
        {
          "name": "Base plate 100x60x3",
