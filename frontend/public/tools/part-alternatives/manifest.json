{
  "id": "part-alternatives", "version": "1.0",
  "name": "Part Alternative Finder",
  "blurb": "alternatives for a part in stock, with basic/extended class compared",
  "group": "pcb",
  "rooms": [
    "pcb"
  ],
  "keywords": [
    "alternative",
    "second source",
    "substitute",
    "replacement",
    "lcsc",
    "jlcpcb",
    "basic part",
    "extended part",
    "loading fee",
    "stock",
    "out of stock",
    "drop-in",
    "cross reference",
    "bom cost"
  ],
  "intro": "Search LCSC for a part (in the app), then the candidates are ranked against the part you have: enough stock for the order, same footprint family, same MPN, no JLCPCB loading fee, lowest order cost. Order cost = quantity × unit price + the Extended-part loading fee, per JLCPCB's assembly pricing.",
  "inputs": [
    {
      "key": "query",
      "label": "Search LCSC for",
      "type": "text",
      "default": "AMS1117-3.3",
      "help": "Press Search LCSC below (in the app). Part number, MPN or a description like 3.3V LDO SOT-223."
    },
    {
      "key": "orig_lcsc",
      "label": "Original LCSC #",
      "type": "text",
      "default": "C6186"
    },
    {
      "key": "orig_mpn",
      "label": "Original MPN",
      "type": "text",
      "default": "AMS1117-3.3"
    },
    {
      "key": "orig_package",
      "label": "Original package",
      "type": "text",
      "default": "SOT-223"
    },
    {
      "key": "orig_class",
      "label": "Original class",
      "type": "select",
      "default": "basic",
      "options": [
        [
          "basic",
          "Basic"
        ],
        [
          "preferred",
          "Preferred"
        ],
        [
          "extended",
          "Extended"
        ],
        [
          "unknown",
          "Unknown"
        ]
      ]
    },
    {
      "key": "orig_price",
      "label": "Original unit price",
      "type": "number",
      "unit": "$",
      "default": "0.2203"
    },
    {
      "key": "orig_stock",
      "label": "Original stock",
      "type": "number",
      "unit": "pcs",
      "default": "",
      "required": false,
      "help": "Empty = unknown."
    },
    {
      "key": "boards",
      "label": "Boards",
      "type": "number",
      "default": "50"
    },
    {
      "key": "per_board",
      "label": "Per board",
      "type": "number",
      "unit": "pcs",
      "default": "2"
    },
    {
      "key": "fee",
      "label": "Extended loading fee",
      "type": "number",
      "unit": "$",
      "default": "3",
      "help": "JLCPCB, per unique Extended part per order."
    },
    {
      "key": "assume",
      "label": "Unknown class counts as",
      "type": "select",
      "default": "extended",
      "options": [
        [
          "extended",
          "Extended (worst case)"
        ],
        [
          "basic",
          "Basic"
        ]
      ]
    },
    {
