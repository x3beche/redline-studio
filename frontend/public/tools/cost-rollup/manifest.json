            "moq": "1",
            "attr": "2"
          },
          {
            "part": "Passives (0402 R/C)",
            "per": "42",
            "price": "0.004",
            "moq": "10000",
            "attr": "5"
          },
          {
            "part": "USB-C receptacle",
            "per": "1",
            "price": "0.32",
            "moq": "1",
            "attr": "2"
          },
          {
            "part": "Li-ion 1000 mAh cell",
            "per": "1",
            "price": "2.6",
            "moq": "100",
            "attr": "0"
          },
          {
            "part": "Status LED",
            "per": "2",
            "price": "0.03",
            "moq": "4000",
            "attr": "3"
          },
          {
            "part": "BLE module",
            "per": "1",
            "price": "2.95",
            "moq": "1",
            "attr": "1"
          }
        ],
        "places": "64",
        "perPlace": "0.012",
        "hand": "0.35",
        "asmSetup": "280",
        "encUnit": "1.20",
        "encTool": "3800",
        "cableUnit": "0.85",
        "testUnit": "0.55",
        "freight": "220",
        "yieldPct": "97",
        "amortize": true
      }
    },
    {
      "title": "100 prototype units, 3D-printed case, no mold",
      "input": {
        "qty": "100",
        "currency": "EUR",
        "pcbUnit": "4.80",
        "pcbNre": "0",
        "bom": [
          {
            "part": "ESP32-S3 module",
            "per": "1",
            "price": "3.1",
            "moq": "1",
            "attr": "0"
          },
          {
            "part": "Passives",
            "per": "25",
            "price": "0.01",
            "moq": "1",
            "attr": "5"
          },
          {
            "part": "OLED 0.96 in",
