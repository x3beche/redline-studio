# Workbench deployment settings (docker-compose.yml, DEPLOY.md).
#
# docker compose: copy this file to `.env` beside docker-compose.yml.
# Portainer: type these in the stack's "Environment variables" (or load
# this file there with "Load variables from .env file").
# Never commit the filled-in copy.

# ===================== required =====================

# The bundled MongoDB's admin password. Letters and digits only: it goes
# into a connection string as it is. Generate one: openssl rand -hex 24
MONGO_ROOT_PASSWORD=

# A host directory for the app's code copy, caches, scratch and secret key
# (absolute path; created if missing). The API starts its work containers
# through the Docker socket with paths under it, so it is mounted at this
# same path inside - it cannot be a named volume. Back it up (DEPLOY.md).
REDLINE_HOST_DIR=/var/lib/workbench

# The published port, and the address it listens on. 127.0.0.1 when a reverse
# proxy on this machine (nginx, Caddy, Traefik, Nginx Proxy Manager) serves
# HTTPS in front of it; 0.0.0.0 for every address.
WORKBENCH_PORT=8080
WORKBENCH_BIND=0.0.0.0

# The owner's account, made on the first start if there is no account yet
# (nothing happens once one exists; you may clear these afterwards). Left
# empty, the first person to open the page makes the owner's account - do
# that before the page is reachable by others.
REDLINE_OWNER_EMAIL=
REDLINE_OWNER_PASSWORD=
REDLINE_OWNER_NAME=

# Encrypts the secrets typed in Settings (model API keys, Telegram token...)
# in the database. A long random string: openssl rand -base64 32
# Left empty, a key is made once in REDLINE_HOST_DIR/secrets/secret.key -
# then keep that file with your backups. Lose the key and those secrets are
# typed in again; nothing else is lost.
REDLINE_SECRET_KEY=

# ===================== optional =====================

# Which work images to build next to the default ones (api, web, mongo, draw):
#   kicad       the board room: placement, routing, DRC, schematics, release outputs (8 GB)
#   firmware    the Firmware room's PlatformIO builds (2 GB)
#   tools       the Tools tab's Check (2.4 GB)
#   tracemaker  routing with TraceMaker (needs kicad)
#   pdf         headless Chromium for the Chat's PDFs (pulled)
#   full        all of them
# COMPOSE_PROFILES=kicad,firmware

# Images: built from this checkout by default and tagged with these names.
# With images published to a registry (.github/workflows/images.yml), set the
# prefix and version and `docker compose pull` instead of building.
# REDLINE_IMAGE_PREFIX=ghcr.io/x3beche/workbench
# REDLINE_VERSION=latest
# REDLINE_WITH_ATO=true            # false: the API image without atopile (no board room builds)

# Sign-in. true (the default here): every request needs a session, accounts
# are made by the owner and admins. false is the single-user local mode -
# never on a machine others can reach.
# REDLINE_REQUIRE_SIGNIN=true
# REDLINE_LOCAL_USER=owner         # the name shown when sign-in is off

# Another MongoDB instead of the bundled one (Atlas, an existing server).
# The bundled one still starts; MONGO_ROOT_PASSWORD is still required.
# MONGODB_URI=mongodb+srv://user:pass@cluster.example.net/
# MONGODB_DB=redline
# MONGO_IMAGE=mongo:7.0
# MONGO_ROOT_USER=workbench
# MONGO_CACHE_GB=1                 # WiredTiger cache

# How much of the machine one work container may take (backend/limits.py).
# Unset: half the cores, 40 % of the memory up to 12g, 4096 processes.
# REDLINE_BOX_CPUS=
# REDLINE_BOX_MEMORY=
# REDLINE_BOX_PIDS=
# REDLINE_BUILD_MEM=10G            # a model build's memory ceiling

# Uploads and figures.
# REDLINE_FILE_MAX_MB=200          # largest file the app keeps
# WEB_MAX_BODY=1g                  # largest request nginx passes on
# STORAGE_QUOTA_MB=10240           # what the Analytics room forecasts against
# REDLINE_TZ=UTC
# REDLINE_KWH_PRICE=
# REDLINE_LOG_LEVEL=info

# Other images the API runs, pulled by Docker when first needed.
# REDLINE_CHROME_IMAGE=zenika/alpine-chrome:with-puppeteer
# REDLINE_KIT_IMAGE=node:20-alpine
# DOCKER_SOCKET=/var/run/docker.sock
